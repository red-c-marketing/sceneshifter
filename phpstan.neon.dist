parameters:
    level: 6
    paths:
        - sister-sync.php
        - uninstall.php
        - src
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    scanFiles:
        - tests/stubs/php-cli-tools.php
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
        - vendor/woocommerce/action-scheduler/functions.php
    scanDirectories:
        - vendor/woocommerce/action-scheduler/classes
    ignoreErrors:
        # build/ is produced by `yarn build` and is not committed.
        -
            identifier: require.fileNotFound
            path: src/Check/EditorAssets.php
            reportUnmatched: false
