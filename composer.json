{
    "name": "redc/sister-sync",
    "description": "Finds links to sister environments and moves content between them safely.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "RedC\\SisterSync\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RedC\\SisterSync\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    }
}
